# ============================================================
# QA Agent — конфигурация (пример)
# Скопируйте в .env и заполните своими значениями.
# ============================================================

# ---- Security (ОБЯЗАТЕЛЬНО смените в проде!) ----
SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
# Сгенерируйте: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---- App ----
APP_NAME=QA Agent
APP_ENV=development
DEBUG=true

# ---- Database ----
# Локально без Docker удобно использовать SQLite:
# DATABASE_URL=sqlite:///./qa.db
DATABASE_URL=postgresql+psycopg2://qa:qa@localhost:5432/qa_agent

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
# true = задачи выполняются в процессе (Redis не нужен); false = worker + Redis
CELERY_ALWAYS_EAGER=false
# dev: авто-подтверждение email при регистрации (SMTP не нужен); в проде false
DEV_AUTO_VERIFY=false

# ---- URLs ----
# Фронтенд раздаётся бэкендом; для локального запуска укажите реальный порт
FRONTEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# ---- JWT ----
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=15

# ---- Rate limits ----
RATE_LIMIT_USER=10/minute
RATE_LIMIT_IP=100/minute

# ---- SMTP (локально MailHog; прод: Яндекс 360 / Mail.ru / Postmark / Sendgrid) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@qa-agent.local
SMTP_TLS=false
SMTP_SSL=false
#SMTP_BACKUP_HOST=smtp.yandex.ru
#SMTP_BACKUP_PORT=587
#SMTP_BACKUP_USER=you@yourdomain.ru
#SMTP_BACKUP_PASSWORD=

# ---- AI models (основной DeepSeek, fallback GigaChat / YandexGPT) ----
AI_PRIMARY=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
GIGACHAT_API_KEY=
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
YANDEXGPT_BASE_URL=https://llm.api.cloud.yandex.net/foundationModels/v1
YANDEXGPT_MODEL=yandexgpt-lite
AI_TIMEOUT_SECONDS=30
AI_RETRIES=3

# ---- Sandbox (изолированный Playwright-контейнер) ----
SANDBOX_RUNNER=local        # docker | local
SANDBOX_IMAGE=qa-agent-sandbox:latest
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEM_LIMIT=1g
SANDBOX_TIMEOUT_SIMPLE_MINUTES=10
SANDBOX_TIMEOUT_FULL_MINUTES=20
SANDBOX_NETWORK=qa_agent_default
SANDBOX_DNS_WHITELIST=      # список разрешённых доменов через запятую
ALLOW_PRIVATE_HOSTS=false
PRIVATE_HOST_WHITELIST=     # только для self-hosted enterprise

# ---- Тарифы/лимиты ----
TRIAL_DAYS=3
PRO_TESTS_MONTHLY=100
PRO_PARALLEL=5
ENTERPRISE_PARALLEL=20
ENTERPRISE_TRIAL_DAYS=7
ENTERPRISE_TRIAL_TESTS=10
REPORT_RETENTION_DAYS=30
MAX_SCENARIO_WORDS=500
FULL_PAGE_MAX_ELEMENTS=50

# ---- Payments (ЮKassa) ----
# test mode = платёж не создаётся в ЮKassa, возвращается тестовая ссылка
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=true

# ---- Messengers ----
TELEGRAM_BOT_TOKEN=
VK_API_TOKEN=

# ---- TestRail / Xray (enterprise) ----
TESTRAIL_URL=
TESTRAIL_USER=
TESTRAIL_PASSWORD=
TESTRAIL_PROJECT_ID=

# ---- Audit ----
AUDIT_ENABLED=true
